          ],
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT mean(\"val\") / 60 / 1000 FROM (SELECT \"PV Total Current\" * \"Battery Voltage\" AS \"val\" FROM \"downsampled_1m\".\"SBMS_Metrics\" WHERE (\"Name\" = 'SBMS0a') AND $timeFilter GROUP BY time(1m) fill(null)) WHERE $timeFilter",
