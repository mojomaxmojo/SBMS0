            {"params": ["null"], "type": "fill"}
          ],
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT mean(\"val\") / 60 / 1000 FROM (SELECT (-\"Battery Current\" + ABS(\"Battery Current\"))/2 * \"Battery Voltage\" AS \"val\" FROM \"downsampled_1m\".\"SBMS_Metrics\" WHERE (\"Name\" = 'SBMS0a') AND $timeFilter GROUP BY time(1m) fill(null)) WHERE $timeFilter",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "time_series"
        },
        {
          "alias": "Verbraucht",
          "datasource": {"type": "influxdb", "uid": "dg20jcsde4wlcd"},
          "groupBy": [
            {"params": ["$__interval"], "type": "time"},
            {"params": ["null"], "type": "fill"}
          ],
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT mean(\"val\") / 60 / 1000 FROM (SELECT \"Battery Voltage\" * (\"PV Total Current\"-\"Battery Current\") AS \"val\" FROM \"downsampled_1m\".\"SBMS_Metrics\" WHERE (\"Name\" = 'SBMS0a') AND $timeFilter GROUP BY time(1m) fill(null)) WHERE $timeFilter",
